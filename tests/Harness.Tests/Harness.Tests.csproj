<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The compiled CLI process is the only test seam: the reference exists to
       build the executable and locate it, not to call into its types. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Harness/Harness.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Default location of the executable under test; HARNESS_CLI overrides it so the
       same suite can be pointed at a published NativeAOT binary. -->
  <PropertyGroup>
    <HarnessCliPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/Harness/bin/$(Configuration)/$(TargetFramework)/harness'))</HarnessCliPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarnessCliPath</_Parameter1>
      <_Parameter2>$(HarnessCliPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
